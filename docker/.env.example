# AideTalk 셀프호스팅 환경변수 예시 (docs/10_DEPLOYMENT.md §1 표가 단일 출처).
# 사용법: cp docker/.env.example docker/.env 후 값 채우기.
# 시크릿 생성: openssl rand -hex 32

# --- Postgres ---
DB_PASSWORD=changeme_use_openssl_rand_hex_32

# --- PubSub / Storage ---
PUBSUB_DRIVER=redis
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/files
# STORAGE_DRIVER=s3 일 때만 필요 (R2/MinIO 호환)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- 공개 URL (위젯 임베드/CORS/초대 링크 기준) ---
SERVER_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:3000

# --- 시크릿 (필수, 32바이트 이상 랜덤) ---
VISITOR_TOKEN_SECRET=changeme_use_openssl_rand_hex_32
SESSION_SECRET=changeme_use_openssl_rand_hex_32

# --- 에디션/기타 ---
# cloud면 ee 모듈 로드(PlanEnforcer/Billing). 미설정 = 셀프호스팅.
EDITION=
# 셀프호스팅에서 http 에이전트 엔드포인트 허용 여부 (프로덕션 권장값: false)
ALLOW_INSECURE_AGENT_ENDPOINT=false
# 없으면 이메일 발송 전부 skip + 로그
SMTP_URL=
LOG_LEVEL=info
# opt-in 익명 텔레메트리 (수집 항목: 설치 UUID, 버전, 워크스페이스 수)
TELEMETRY=false
