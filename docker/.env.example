# AideTalk 셀프호스팅 환경변수 예시 (docs/10_DEPLOYMENT.md §1 표가 단일 출처).
# 사용법: cp docker/.env.example docker/.env 후 값 채우기.
# 시크릿 생성: openssl rand -hex 32

# --- Postgres ---
DB_PASSWORD=changeme_use_openssl_rand_hex_32

# --- PubSub / Storage ---
PUBSUB_DRIVER=redis
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/data/files
# STORAGE_DRIVER=s3 일 때만 필요 (R2/MinIO 호환)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- 공개 URL (단일 도메인 진입점) ---
# PUBLIC_URL 하나가 Caddy 사이트 주소이자 server/dashboard의 공개 오리진이다.
#   - 로컬: 비워두면 http://localhost (Caddy 평문 HTTP, 인증서 경고 없음).
#   - 프로덕션: https://cs.example.com 형식(scheme 포함). https:// 면 Caddy가 자동 HTTPS + HTTP/3.
#     (DNS A 레코드가 이 도메인을 서버 IP로 가리켜야 인증서 발급이 된다 — docs/10 §2.)
PUBLIC_URL=
# 아래 SERVER_URL/DASHBOARD_URL은 단일 도메인에선 PUBLIC_URL에서 자동 파생되므로 비워둔다.
# server와 dashboard를 서로 다른 오리진으로 분리 배포할 때만(기존 리버스 프록시 사용자, docs/10 §2)
# 명시해서 오버라이드한다. 위젯 임베드/CORS/초대 링크 기준값이 된다.
# SERVER_URL=https://api.example.com
# DASHBOARD_URL=https://app.example.com

# --- 시크릿 (필수, 32바이트 이상 랜덤) ---
VISITOR_TOKEN_SECRET=changeme_use_openssl_rand_hex_32
SESSION_SECRET=changeme_use_openssl_rand_hex_32
# agent/웹훅 secret 암호화 전용 키(선택, 32바이트 hex/base64). 비워두면 SESSION_SECRET 파생으로
# 폴백하고 부팅 시 경고 로그를 남긴다 — 세션 키 로테이션과 분리하려면 값을 채우는 것을 권장한다.
SECRET_ENC_KEY=

# --- 에디션/기타 ---
# cloud면 ee 모듈 로드(PlanEnforcer/Billing). 미설정 = 셀프호스팅.
EDITION=
# 에이전트/웹훅 endpoint의 SSRF 가드 완화 스위치 (권장값: false)
#  - false(기본): https만 허용 + 공인 IP로 리졸브되는 endpoint만 허용한다.
#    사설/루프백/내부망(10.x, 172.16~31.x, 192.168.x, 127.x, ::1, fc00::/7)은 거부 → SSRF 차단.
#  - true: http와 사설/내부 IP endpoint를 허용한다. 같은 도커 네트워크나 LAN에 띄운
#    자기 에이전트(예: http://my-agent:8080, http://192.168.1.10:3000)에 붙일 때 필요하다.
#    ⚠️ 트레이드오프: 켜면 서버가 워크스페이스 멤버가 지정한 내부망 주소로 요청을 보낼 수 있게 된다.
#    워크스페이스 멤버를 신뢰할 수 있을 때만 켤 것(멤버 = 내부 직원인 경우).
#    켜더라도 클라우드 메타데이터/링크로컬 대역(169.254.0.0/16, fe80::/10, fd00:ec2::254)은 항상 차단한다.
ALLOW_INSECURE_AGENT_ENDPOINT=false
# 공개 회원가입 허용 여부(기본 false = 첫 관리자 계정 생성 후 자동으로 닫힘).
# false여도 (1) 유저가 0명인 설치 직후 첫 가입, (2) 초대받은 이메일의 가입은 항상 허용된다.
# 즉 설치 → 첫 가입(=관리자) → 이후 팀원은 초대로만 합류. 누구나 가입 가능하게 열려면 true.
ALLOW_PUBLIC_SIGNUP=false
# 없으면 이메일 발송 전부 skip + 로그
SMTP_URL=
LOG_LEVEL=info
# opt-in 익명 텔레메트리(기본 OFF). true로 명시적으로 켤 때만 동작한다.
# 수집 항목(10_DEPLOYMENT.md §1-1): 인스턴스 익명 ID, 버전, 워크스페이스/대화/에이전트 개수만.
# 내용·PII는 절대 수집하지 않는다.
TELEMETRY_ENABLED=false
# 텔레메트리 전송 대상 URL. placeholder — 실제 수집 서버 도메인 확정 전(TODO(action)).
TELEMETRY_ENDPOINT=https://telemetry.aidetalk.invalid/v1/ping

# --- 마이그레이션 ---
# 부팅 시 DB 마이그레이션 자동 실행. compose 기본값은 true(원커맨드 설치 전제) — 비워두면 켜진다.
# 여러 서버 인스턴스로 수평 확장할 때만 false로 두고 마이그레이션을 별도 스텝으로 돌린다.
RUN_MIGRATIONS_ON_BOOT=true
