{
  "name": "@aidetalk/widget",
  "version": "0.0.0",
  "private": true,
  "description": "임베드 채팅 위젯 (Preact + Shadow DOM). React 금지, Preact까지만 — 번들 예산 50KB gzip",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5173",
    "build": "vite build && vite build --config vite.loader.config.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "size": "pnpm run build && size-limit"
  },
  "dependencies": {
    "@aidetalk/i18n": "workspace:*",
    "@aidetalk/shared": "workspace:*",
    "preact": "^10.29.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@preact/preset-vite": "^2.10.5",
    "@size-limit/file": "^11.1.6",
    "@types/node": "^22.10.2",
    "jsdom": "^25.0.1",
    "size-limit": "^11.1.6",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
