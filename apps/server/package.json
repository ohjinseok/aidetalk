{
  "name": "@aidetalk/server",
  "version": "0.0.0",
  "private": true,
  "description": "Hono(HTTP) + ws(WebSocket) 단일 Node 프로세스 — API 게이트웨이 + Agent Dispatcher",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
