{
  "name": "aidetalk",
  "version": "0.0.0",
  "private": true,
  "description": "AideTalk — 한국 SMB를 위한 오픈소스 CS 메신저",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.2.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "size": "turbo run size --filter=@aidetalk/widget",
    "db:generate": "pnpm --filter @aidetalk/db db:generate",
    "db:migrate": "pnpm --filter @aidetalk/db db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.39.4",
    "prettier": "^3.9.4",
    "turbo": "^2.10.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^2.1.9"
  }
}
